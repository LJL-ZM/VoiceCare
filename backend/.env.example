# VoiceCare 后端服务环境变量配置
# 华为云 API 凭证 - 不要提交到 git

# 华为云 MaaS 语音转写配置
HUAWEI_CLOUD_MAAS_ENDPOINT=https://maas.cn-north-4.myhuaweicloud.com
HUAWEI_CLOUD_MAAS_AK=YOUR_MAAS_ACCESS_KEY
HUAWEI_CLOUD_MAAS_SK=YOUR_MAAS_SECRET_KEY

# 华为云盘古大模型配置
PANGU_API_ENDPOINT=https://pangu.cn-north-4.myhuaweicloud.com
PANGU_API_KEY=YOUR_PANGU_API_KEY

# 华为云 OBS 配置
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_ACCESS_KEY=YOUR_OBS_ACCESS_KEY
OBS_SECRET_KEY=YOUR_OBS_SECRET_KEY
OBS_BUCKET_NAME=voiccare-audio

# 数据库配置 (RDS)
DB_HOST=your-rds-host.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=voicare
DB_USER=voicare_user
DB_PASSWORD=your_db_password

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# 算法服务配置
ALGO_BASELINE_THRESHOLD=0.3
ALGO_MEDIUM_THRESHOLD=0.5
ALGO_HIGH_THRESHOLD=0.7